<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NJ Swimming Group — AI 기반 수영학교 관리 시스템</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ── 리셋 & 베이스 ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0A2342; --navy2:#0D1F35; --navy3:#122034;
  --teal:#1D9E75; --teal-m:#5DCAA5; --teal-l:#E1F5EE; --teal-d:#085041;
  --blue:#185FA5; --blue-l:#E6F1FB; --blue-m:#85B7EB;
  --amber:#BA7517; --amber-l:#FAEEDA;
  --red:#A32D2D; --red-l:#FCEBEB;
  --pu:#534AB7; --pu-l:#EEEDFE;
  --white:#FFFFFF; --off:#F0F9F5;
  --gray:#8A9BB0; --gray-l:#EEF2F7;
  --mid:#2C3E50;
  --font-display:'Playfair Display',serif;
  --font-body:'Inter',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}
html{scroll-behavior:smooth;font-size:16px}
body{
  font-family:var(--font-body);
  background:var(--navy);
  color:var(--white);
  overflow-x:hidden;
  line-height:1.6;
}
::selection{background:var(--teal);color:#fff}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}

/* ── 스크롤 애니메이션 ── */
.reveal{
  opacity:0;
  transform:translateY(32px);
  transition:opacity .7s ease, transform .7s ease;
}
.reveal.visible{opacity:1;transform:translateY(0)}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;
  z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 5%;
  height:64px;
  background:rgba(10,35,66,.88);
  backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(93,202,165,.15);
  transition:background .3s;
}
.nav-logo{
  display:flex;align-items:center;gap:12px;
  font-family:var(--font-display);
  font-weight:700;font-size:1.15rem;color:var(--white);
}
.nav-logo-icon{
  width:38px;height:38px;border-radius:50%;
  border:2px solid var(--teal-m);
  display:flex;align-items:center;justify-content:center;
  background:rgba(29,158,117,.15);
  font-size:.9rem;font-weight:800;color:var(--teal-m);
  font-family:var(--font-mono);
  flex-shrink:0;
}
.nav-links{
  display:flex;gap:28px;list-style:none;
}
.nav-links a{
  font-size:.82rem;font-weight:500;color:var(--gray);
  letter-spacing:.03em;transition:color .2s;
}
.nav-links a:hover{color:var(--teal-m)}
.nav-badge{
  font-size:.72rem;font-weight:600;
  background:rgba(29,158,117,.18);
  color:var(--teal-m);border:1px solid rgba(93,202,165,.3);
  padding:4px 12px;border-radius:20px;
}

/* ── HERO ── */
.hero{
  min-height:100vh;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  position:relative;overflow:hidden;
  padding:100px 5% 80px;
  text-align:center;
}
.hero-bg{
  position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 50% 40%,rgba(29,158,117,.12) 0%,transparent 70%),
             radial-gradient(ellipse 40% 40% at 20% 80%,rgba(24,95,165,.1) 0%,transparent 60%);
}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
  color:var(--teal-m);border:1px solid rgba(93,202,165,.35);
  padding:6px 16px;border-radius:20px;
  background:rgba(29,158,117,.1);
  margin-bottom:28px;
}
.hero-eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--teal);display:inline-block;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.hero-title{
  font-family:var(--font-display);
  font-size:clamp(2.6rem,6vw,5rem);
  font-weight:900;line-height:1.08;
  letter-spacing:-.02em;
  color:var(--white);
  margin-bottom:16px;
}
.hero-title span{color:var(--teal-m)}
.hero-sub{
  font-size:clamp(1rem,2vw,1.3rem);
  color:var(--gray);font-weight:300;
  max-width:580px;margin:0 auto 40px;
  line-height:1.65;
}
.hero-cta-row{
  display:flex;gap:14px;justify-content:center;flex-wrap:wrap;
  margin-bottom:60px;
}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 28px;border-radius:8px;
  font-size:.88rem;font-weight:600;
  cursor:pointer;border:none;transition:all .2s;
}
.btn-primary{background:var(--teal);color:#fff}
.btn-primary:hover{background:var(--teal-d);transform:translateY(-2px)}
.btn-outline{
  background:transparent;color:var(--teal-m);
  border:1.5px solid rgba(93,202,165,.45);
}
.btn-outline:hover{background:rgba(29,158,117,.1);transform:translateY(-2px)}

/* 히어로 통계 카드 */
.hero-stats{
  display:flex;gap:20px;justify-content:center;flex-wrap:wrap;
  position:relative;z-index:2;
}
.stat-card{
  background:rgba(255,255,255,.06);
  border:1px solid rgba(93,202,165,.2);
  border-radius:12px;padding:20px 28px;text-align:center;
  backdrop-filter:blur(8px);
  transition:transform .2s,border-color .2s;
}
.stat-card:hover{transform:translateY(-4px);border-color:rgba(93,202,165,.5)}
.stat-num{
  font-family:var(--font-display);
  font-size:2rem;font-weight:700;color:var(--teal-m);
  display:block;line-height:1;margin-bottom:4px;
}
.stat-label{font-size:.75rem;color:var(--gray);letter-spacing:.04em}

/* 물결 구분선 */
.wave-divider{
  width:100%;overflow:hidden;line-height:0;
}
.wave-divider svg{display:block;width:100%}

/* ── SECTIONS 공통 ── */
section{padding:90px 5%}
.section-light{background:var(--off);color:var(--mid)}
.section-mid{background:#0D1F35}
.container{max-width:1100px;margin:0 auto}
.section-label{
  font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--teal-m);margin-bottom:12px;
  display:flex;align-items:center;gap:8px;
}
.section-label::after{content:'';flex:1;max-width:40px;height:1px;background:var(--teal)}
.section-title{
  font-family:var(--font-display);
  font-size:clamp(1.8rem,3.5vw,2.8rem);
  font-weight:700;line-height:1.15;
  margin-bottom:16px;
}
.section-light .section-title{color:var(--navy)}
.section-desc{font-size:1rem;line-height:1.7;color:var(--gray);max-width:560px}
.section-light .section-desc{color:#5A6A7A}

/* ── 문제 vs 해결 ── */
.prob-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:28px;
  margin-top:50px;
}
@media(max-width:700px){.prob-grid{grid-template-columns:1fr}}
.prob-card,.sol-card{
  border-radius:16px;padding:32px;
}
.prob-card{
  background:rgba(163,45,45,.07);
  border:1px solid rgba(163,45,45,.25);
}
.prob-card h3{color:#E06060;font-size:1rem;font-weight:600;margin-bottom:20px;display:flex;align-items:center;gap:8px}
.sol-card{
  background:rgba(29,158,117,.07);
  border:1px solid rgba(93,202,165,.3);
}
.sol-card h3{color:var(--teal-m);font-size:1rem;font-weight:600;margin-bottom:20px;display:flex;align-items:center;gap:8px}
.prob-list,.sol-list{list-style:none;display:flex;flex-direction:column;gap:10px}
.prob-list li,.sol-list li{
  display:flex;align-items:flex-start;gap:10px;
  font-size:.88rem;line-height:1.55;color:#A8C4D8;
}
.prob-list li::before{content:'✕';color:#E06060;font-weight:700;flex-shrink:0;margin-top:1px}
.sol-list li::before{content:'✓';color:var(--teal-m);font-weight:700;flex-shrink:0;margin-top:1px}

/* ── AI 활용 방법 ── */
.ai-steps{
  display:grid;grid-template-columns:repeat(2,1fr);gap:22px;
  margin-top:50px;
}
@media(max-width:700px){.ai-steps{grid-template-columns:1fr}}
.ai-step{
  background:rgba(255,255,255,.04);
  border:1px solid rgba(93,202,165,.18);
  border-radius:14px;padding:28px;
  transition:border-color .2s,transform .2s;
}
.ai-step:hover{border-color:rgba(93,202,165,.5);transform:translateY(-3px)}
.step-num{
  width:40px;height:40px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-size:.85rem;font-weight:600;
  color:var(--white);margin-bottom:16px;
}
.ai-step h3{font-size:1rem;font-weight:600;margin-bottom:8px;color:var(--white)}
.ai-step p{font-size:.85rem;color:var(--gray);line-height:1.6}

/* ── 기능 카드 그리드 ── */
.features-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
  margin-top:50px;
}
@media(max-width:900px){.features-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.features-grid{grid-template-columns:1fr}}
.feat-card{
  background:var(--white);
  border:1px solid #D4E8F5;
  border-radius:14px;padding:24px;
  transition:transform .2s,box-shadow .2s;
}
.feat-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.08)}
.feat-icon{font-size:1.8rem;margin-bottom:14px;display:block}
.feat-card h3{font-size:.95rem;font-weight:700;color:var(--navy);margin-bottom:6px}
.feat-card p{font-size:.83rem;color:#5A6A7A;line-height:1.6}

/* ── 출석 코드 ── */
.code-grid{
  display:grid;grid-template-columns:repeat(4,1fr);gap:16px;
  margin-top:40px;
}
@media(max-width:800px){.code-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.code-grid{grid-template-columns:1fr 1fr}}
.code-card{
  border-radius:12px;padding:20px 18px;
  border:1px solid rgba(255,255,255,.12);
  background:rgba(255,255,255,.05);
  transition:transform .2s;
}
.code-card:hover{transform:translateY(-3px)}
.code-badge{
  display:inline-flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-weight:700;
  border-radius:8px;padding:6px 14px;
  font-size:.95rem;margin-bottom:12px;
  border:1.5px solid;
}
.code-name{font-size:.9rem;font-weight:600;color:var(--white);margin-bottom:4px}
.code-desc{font-size:.78rem;color:var(--gray);line-height:1.5}

/* ── 양방향 연동 다이어그램 ── */
.sync-diagram{
  display:grid;grid-template-columns:1fr auto 1fr;
  gap:20px;align-items:center;margin-top:50px;
}
@media(max-width:700px){
  .sync-diagram{grid-template-columns:1fr;text-align:center}
  .sync-arrow{transform:rotate(90deg)}
}
.sync-box{
  border-radius:16px;padding:28px;
}
.sync-box.sheets{
  background:rgba(39,174,96,.08);
  border:1.5px solid rgba(39,174,96,.35);
}
.sync-box.app{
  background:rgba(24,95,165,.08);
  border:1.5px solid rgba(24,95,165,.35);
}
.sync-box h3{font-size:1rem;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.sync-box.sheets h3{color:#4ADE80}
.sync-box.app h3{color:var(--blue-m)}
.sync-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.sync-list li{font-size:.83rem;color:#A8C4D8;display:flex;align-items:flex-start;gap:8px;line-height:1.5}
.sync-list li::before{font-size:.7rem;margin-top:2px;flex-shrink:0}
.sync-box.sheets .sync-list li::before{content:'▶';color:#4ADE80}
.sync-box.app .sync-list li::before{content:'▶';color:var(--blue-m)}
.sync-arrow{
  display:flex;flex-direction:column;align-items:center;gap:8px;
  font-size:.78rem;font-weight:600;color:var(--teal-m);
}
.sync-arrow svg{width:48px}

/* 시트 기재 형식 박스 */
.code-format{
  background:var(--navy3);border:1px solid rgba(93,202,165,.2);
  border-radius:12px;padding:24px;margin-top:36px;
}
.code-format h4{
  font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  color:var(--teal-m);margin-bottom:16px;
}
.code-format pre{
  font-family:var(--font-mono);font-size:.8rem;
  color:#A8C4D8;line-height:2;
}
.code-format .hi{color:var(--teal-m);font-weight:600}

/* ── 버전 타임라인 ── */
.timeline{
  position:relative;
  margin-top:50px;
  padding-left:24px;
}
.timeline::before{
  content:'';position:absolute;left:0;top:0;bottom:0;
  width:2px;background:linear-gradient(to bottom,var(--teal),var(--blue));
  border-radius:2px;
}
.tl-item{
  position:relative;padding:0 0 40px 32px;
}
.tl-item:last-child{padding-bottom:0}
.tl-dot{
  position:absolute;left:-11px;top:4px;
  width:22px;height:22px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-size:.65rem;font-weight:700;
  border:2px solid var(--navy2);
  color:var(--white);
}
.tl-version{
  font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  margin-bottom:4px;
}
.tl-title{
  font-size:1rem;font-weight:600;color:var(--white);margin-bottom:6px;
}
.tl-desc{font-size:.85rem;color:var(--gray);line-height:1.6}
.tl-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.tl-tag{
  font-size:.7rem;font-weight:500;
  padding:3px 10px;border-radius:20px;
  background:rgba(255,255,255,.07);color:var(--gray);
  border:1px solid rgba(255,255,255,.1);
}

/* ── 레인 배치 ── */
.lane-vis{
  background:rgba(29,158,117,.08);
  border:1px solid rgba(93,202,165,.25);
  border-radius:14px;padding:28px;
  margin-top:36px;
}
.lane-row{
  display:flex;align-items:center;gap:12px;
  padding:10px 14px;border-radius:8px;
  margin-bottom:8px;
  transition:background .15s;
}
.lane-row:last-child{margin-bottom:0}
.lane-row:hover{background:rgba(255,255,255,.05)}
.lane-num{
  font-family:var(--font-mono);font-size:.78rem;font-weight:600;
  color:var(--teal-m);width:56px;flex-shrink:0;
}
.lane-lvs{display:flex;gap:6px;flex:1;flex-wrap:wrap}
.lv-pill{
  display:inline-flex;align-items:center;gap:5px;
  font-size:.75rem;font-weight:600;
  padding:3px 10px;border-radius:20px;border:1px solid;
}
.lv1{background:#FCEBEB;color:#A32D2D;border-color:#F09595}
.lv2{background:#FAECE7;color:#712B13;border-color:#F0997B}
.lv3{background:#FAEEDA;color:#BA7517;border-color:#EF9F27}
.lv4{background:#E1F5EE;color:#085041;border-color:#5DCAA5}
.lv5{background:#E6F1FB;color:#0C447C;border-color:#85B7EB}
.lv6{background:#2C2C2A;color:#D3D1C7;border-color:#5F5E5A}
.lv-dot-s{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.lane-instr{font-size:.78rem;color:var(--gray);white-space:nowrap}
.lane-me{
  background:rgba(29,158,117,.12) !important;
  border:1px solid rgba(93,202,165,.4);
}

/* ── 앱 목업 ── */
.mockup-row{
  display:grid;grid-template-columns:1fr 1fr;gap:32px;
  align-items:start;margin-top:50px;
}
@media(max-width:700px){.mockup-row{grid-template-columns:1fr}}
.phone-frame{
  background:var(--navy3);border:2px solid rgba(93,202,165,.2);
  border-radius:24px;overflow:hidden;
  box-shadow:0 32px 80px rgba(0,0,0,.4);
  max-width:300px;margin:0 auto;
}
.phone-notch{
  height:36px;background:var(--navy2);
  display:flex;align-items:center;justify-content:center;
}
.notch-bar{width:60px;height:4px;background:rgba(255,255,255,.1);border-radius:2px}
.phone-screen{padding:16px}
.screen-topbar{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:12px;
}
.screen-logo{
  display:flex;align-items:center;gap:7px;
  font-size:.75rem;font-weight:700;color:var(--white);
}
.screen-logo-ico{
  width:24px;height:24px;border-radius:50%;
  background:rgba(29,158,117,.2);border:1.5px solid var(--teal-m);
  display:flex;align-items:center;justify-content:center;
  font-size:.55rem;font-weight:800;color:var(--teal-m);font-family:var(--font-mono);
}
.screen-nav{
  display:flex;border-bottom:1px solid rgba(255,255,255,.08);
  margin-bottom:12px;
}
.screen-tab{
  flex:1;text-align:center;padding:6px 2px;
  font-size:.6rem;color:rgba(255,255,255,.4);
  border-bottom:2px solid transparent;
}
.screen-tab.act{color:var(--teal-m);border-bottom-color:var(--teal)}
.screen-banner{
  background:var(--blue-l);border:1px solid var(--blue-m);
  border-radius:8px;padding:9px 11px;margin-bottom:10px;
  font-size:.68rem;color:var(--blue);line-height:1.5;
}
.screen-banner strong{display:block;font-size:.72rem;font-weight:700;color:var(--bd,#0C447C);margin-bottom:2px}
.screen-stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-bottom:10px}
.screen-stat{
  background:rgba(255,255,255,.06);border-radius:6px;padding:6px;text-align:center;
}
.screen-stat-n{font-size:.85rem;font-weight:700;color:var(--teal-m);display:block}
.screen-stat-l{font-size:.55rem;color:rgba(255,255,255,.4)}
.screen-card{
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  border-radius:8px;padding:10px;margin-bottom:7px;
}
.screen-lv{
  display:inline-flex;align-items:center;gap:4px;
  font-size:.65rem;font-weight:700;padding:2px 8px;border-radius:20px;
  margin-bottom:5px;
}
.screen-time{font-size:.65rem;color:rgba(255,255,255,.45);margin-bottom:4px}
.screen-dots{display:flex;gap:2px}
.sdot{width:14px;height:14px;border-radius:2px;font-size:.55rem;display:flex;align-items:center;justify-content:center;font-weight:700}
.sdot-o{background:#EAF3DE;color:#27500A}
.sdot-x{background:#FCEBEB;color:#791F1F}
.sdot-m{background:#FAEEDA;color:#BA7517}
.sdot-b{background:#EEEDFE;color:#534AB7}
.sdot-ns{background:#2C2C2A;color:#D3D1C7}
.sdot-n{background:rgba(255,255,255,.08);color:rgba(255,255,255,.3)}

/* 오른쪽 설명 */
.mockup-desc{display:flex;flex-direction:column;gap:22px;justify-content:center}
.desc-item{display:flex;gap:14px;align-items:flex-start}
.desc-icon{
  width:38px;height:38px;border-radius:10px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:1.1rem;
  background:rgba(29,158,117,.12);border:1px solid rgba(93,202,165,.25);
}
.desc-item h4{font-size:.9rem;font-weight:600;color:var(--white);margin-bottom:3px}
.desc-item p{font-size:.82rem;color:var(--gray);line-height:1.55}

/* ── 기술 스택 ── */
.stack-grid{
  display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:40px;
}
@media(max-width:600px){.stack-grid{grid-template-columns:1fr}}
.stack-card{
  border-radius:12px;padding:24px;
}
.stack-card.now{
  background:rgba(186,117,23,.07);
  border:1px solid rgba(186,117,23,.3);
}
.stack-card.next{
  background:rgba(29,158,117,.07);
  border:1px solid rgba(93,202,165,.3);
}
.stack-card h3{
  font-size:.88rem;font-weight:700;margin-bottom:16px;
  display:flex;align-items:center;gap:8px;
}
.stack-card.now h3{color:var(--amber)}
.stack-card.next h3{color:var(--teal-m)}
.stack-row{
