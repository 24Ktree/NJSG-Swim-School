<!-- 스크롤 애니메이션 JS -->
<script>
// Intersection Observer로 reveal 애니메이션
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// 토/일 슬롯 동적 렌더링
const satTimes = ["9:00am","9:45am","10:30am","11:15am","12:00pm","12:45pm","1:30pm","2:15pm","3:00pm","3:45pm","4:30pm","5:15pm","6:00pm"];
const sunTimes = ["9:00am","9:45am","10:30am","11:15am","12:00pm","12:45pm","1:30pm","2:15pm","3:00pm","3:45pm","4:30pm","5:15pm","6:00pm","6:45pm"];

// 시간표 섹션에 동적으로 채우기
document.querySelectorAll('[data-sat-slots]').forEach(el => {
  el.innerHTML = satTimes.map(t =>
    `<div style="font-size:.78rem;padding:3px 0;border-bottom:1px solid #EEF2F7;color:var(--mid)">${t}</div>`
  ).join('');
});
document.querySelectorAll('[data-sun-slots]').forEach(el => {
  el.innerHTML = sunTimes.map(t =>
    `<div style="font-size:.78rem;padding:3px 0;border-bottom:1px solid #EEF2F7;color:var(--mid)">${t}</div>`
  ).join('');
});

// 토/일 슬롯 인라인 렌더
const satBox = document.querySelector('#sat-dynamic');
const sunBox = document.querySelector('#sun-dynamic');
if (satBox) satBox.innerHTML = satTimes.map(t => `<div style="font-size:.78rem;padding:3px 0;border-bottom:1px solid #EEF2F7;color:var(--mid)">${t}</div>`).join('');
if (sunBox) sunBox.innerHTML = sunTimes.map(t => `<div style="font-size:.78rem;padding:3px 0;border-bottom:1px solid #EEF2F7;color:var(--mid)">${t}</div>`).join('');

// 스크롤 시 nav 스타일
window.addEventListener('scroll', () => {
  const nav = document.querySelector('nav');
  if (window.scrollY > 60) {
    nav.style.background = 'rgba(10,35,66,.97)';
  } else {
    nav.style.background = 'rgba(10,35,66,.88)';
  }
});

// 토/일 시간표 정적 렌더 (이미 HTML에 작성되어 있으므로 JS template string 결과 제거)
const satSlotEls = document.querySelectorAll('.sat-slot-list');
const sunSlotEls = document.querySelectorAll('.sun-slot-list');
satSlotEls.forEach(el => {
  el.innerHTML = satTimes.map(t =>
    `<div style="font-size:.78rem;padding:3px 0;border-bottom:1px solid #EEF2F7;color:var(--mid)">${t}</div>`
  ).join('');
});
sunSlotEls.forEach(el => {
  el.innerHTML = sunTimes.map(t =>
    `<div style="font-size:.78rem;padding:3px 0;border-bottom:1px solid #EEF2F7;color:var(--mid)">${t}</div>`
  ).join('');
});
</script>

